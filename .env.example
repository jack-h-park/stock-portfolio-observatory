# Path to your private source exports. Do not commit the source data directory.
STOCK_DATA_DIR=/path/to/private/stock-management

# Generated database. Keep this outside git.
STOCK_DB_PATH=/path/to/private/stock-management/outputs/stock-portfolio-observatory/stock-portfolio-observatory.db

# Local generated snapshots. Copy the matching .example.json files first when bootstrapping.
STOCK_FX_RATES_PATH=./data/fx-rates.json
STOCK_KR_PRICES_PATH=./data/kr-prices.json
STOCK_US_PRICES_PATH=./data/us-prices.json
STOCK_US_PDF_EVIDENCE_PATH=./data/us-pdf-evidence.json
STOCK_MANUAL_MAPPINGS_PATH=./data/manual-mappings.json
STOCK_REFRESH_RUNS_PATH=./data/refresh-runs.json

# Optional. Set this when your default python3 does not have pdfplumber installed.
STOCK_PYTHON_BIN=python3
