# Path to your private source exports. Do not commit the source data directory.
STOCK_DATA_DIR=/path/to/private/stock-management

# Generated database. Keep this outside git.
STOCK_DB_PATH=/path/to/private/stock-management/outputs/stock-portfolio-observatory/stock-portfolio-observatory.db

# Local generated snapshots. Copy the matching .example.json files first when bootstrapping.
STOCK_FX_RATES_PATH=./data/fx-rates.json
STOCK_KR_PRICES_PATH=./data/kr-prices.json
STOCK_US_PRICES_PATH=./data/us-prices.json
STOCK_US_PDF_EVIDENCE_PATH=./data/us-pdf-evidence.json
# Crypto activity extracted from the exchange PDFs, and the per-venue quotes
# priced from it. Both are generated by `pnpm refresh`; both carry position
# sizes, so they stay out of git.
STOCK_CRYPTO_ACTIVITY_PATH=./data/crypto-activity.json
STOCK_CRYPTO_PRICES_PATH=./data/crypto-prices.json
STOCK_MANUAL_MAPPINGS_PATH=./data/manual-mappings.json
STOCK_REFRESH_RUNS_PATH=./data/refresh-runs.json

# Machine-readable portfolio summary, WRITTEN by `pnpm summary` (and by the tail
# of `pnpm refresh`) for the briefing and trading-agent crons to read. This is the
# one file this app publishes rather than consumes. Keep it outside git — it
# carries position values — and point the consuming jobs at this same path.
STOCK_BRIEFING_SUMMARY_PATH=/path/to/private/stock-management/outputs/stock-portfolio-observatory/briefing-summary.json

# Daily portfolio briefing archive, written by the briefing cron on the same host.
# Read-only for this app. Keep it outside git — the documents carry position sizes.
STOCK_BRIEFING_ARCHIVE_DIR=/path/to/private/stock-management/briefing-archive

# Toss Securities Open API (OAuth2 client credentials). Toss is 36 of the 47
# Korean holdings, so this is the path that keeps them current without anyone
# updating a spreadsheet. Note the API also enforces an IP allowlist: valid keys
# from an unregistered address fail with 403 `IP address not allowed`.
TOSS_OPENAPI_CLIENT_ID=
TOSS_OPENAPI_CLIENT_SECRET=
STOCK_TOSS_SNAPSHOT_PATH=./data/toss-snapshot.json

# Robinhood open lots, straight from the Robinhood MCP. Generated, not
# downloaded — so it lives here in `data/` and never under STOCK_DATA_DIR, which
# is only for files a person fetched from a broker by hand.
#
# There is no script and no cron for it: the MCP is reachable from an agent
# session, not from a shell, so this file only moves when a session regenerates
# it. `robinhood_snapshot_fresh` is what makes that visible.
STOCK_ROBINHOOD_SNAPSHOT_PATH=./data/robinhood-snapshot.json

# How old the Robinhood snapshot may be before `robinhood_snapshot_fresh` warns,
# in days. A week, because regenerating it is a deliberate act rather than
# something a timer does — a daily deadline would be a warning nobody can clear.
STOCK_ROBINHOOD_SNAPSHOT_MAX_DAYS=7

# Korea broker certificates, parsed by `pnpm extract:kr-statements`. These rows
# REPLACE the payload rows for the accounts they cover and leave every other
# brokerage alone, so the directory can appear before every account is covered.
STOCK_KR_STATEMENTS_DIR=./data/kr-statements

# How old a 거래내역서 may be before `toss_positions_fresh` warns, in days, and
# only on the branch where a statement is what backs the Toss positions — with an
# Open API snapshot the threshold is 24h instead. Monthly-plus-slack, because a
# hand-downloaded statement is never hours old and demanding that it be would
# leave a warning nobody can clear.
STOCK_TOSS_STATEMENT_MAX_DAYS=35

# Password for the encrypted 미래에셋 주식종합 / 삼성증권 certificates. The ISA
# statements are not encrypted, so the extraction still runs without this — it
# reports which files it could not open rather than skipping them quietly.
STOCK_PDF_PASSWORD=

# Interpreter for the PDF extraction step. Use an ABSOLUTE path, and install
# BOTH extract modules into it: pdfplumber and openpyxl. A missing openpyxl does
# not fail the run — it just leaves every Bithumb deposit reason blank.
#   "$STOCK_PYTHON_BIN" -m pip install --user pdfplumber openpyxl
# A bare "python3" resolves through PATH, and the scheduler does not hand the job
# the PATH you get in a shell: Hermes cron puts its own virtualenv first, so
# "python3" became that venv's 3.11 — which has no pdfplumber — and the refresh
# failed at the extract step every run while working perfectly by hand.
STOCK_PYTHON_BIN=/usr/bin/python3

# Where scripts/push-sources.sh sends broker downloads. The pipeline runs on one
# machine and the exports land on another, because brokers want a browser
# session — this pushes the source directories one way and never touches the
# generated `outputs/` on the far side.
STOCK_PROD_HOST=user@host
STOCK_PROD_DATA_DIR=workspace/data/stock-management
