# Path to your private source exports. Do not commit the source data directory.
STOCK_DATA_DIR=/path/to/private/stock-management

# Generated database. Keep this outside git.
STOCK_DB_PATH=/path/to/private/stock-management/outputs/stock-portfolio-observatory/stock-portfolio-observatory.db

# Local generated snapshots. Copy the matching .example.json files first when bootstrapping.
STOCK_FX_RATES_PATH=./data/fx-rates.json
STOCK_KR_PRICES_PATH=./data/kr-prices.json
STOCK_US_PRICES_PATH=./data/us-prices.json
STOCK_US_PDF_EVIDENCE_PATH=./data/us-pdf-evidence.json
STOCK_MANUAL_MAPPINGS_PATH=./data/manual-mappings.json
STOCK_REFRESH_RUNS_PATH=./data/refresh-runs.json

# Machine-readable portfolio summary, WRITTEN by `pnpm summary` (and by the tail
# of `pnpm refresh`) for the briefing and trading-agent crons to read. This is the
# one file this app publishes rather than consumes. Keep it outside git — it
# carries position values — and point the consuming jobs at this same path.
STOCK_BRIEFING_SUMMARY_PATH=/path/to/private/stock-management/outputs/stock-portfolio-observatory/briefing-summary.json

# Daily portfolio briefing archive, written by the briefing cron on the same host.
# Read-only for this app. Keep it outside git — the documents carry position sizes.
STOCK_BRIEFING_ARCHIVE_DIR=/path/to/private/stock-management/briefing-archive

# Interpreter for the PDF extraction step. Use an ABSOLUTE path.
# A bare "python3" resolves through PATH, and the scheduler does not hand the job
# the PATH you get in a shell: Hermes cron puts its own virtualenv first, so
# "python3" became that venv's 3.11 — which has no pdfplumber — and the refresh
# failed at the extract step every run while working perfectly by hand.
STOCK_PYTHON_BIN=/usr/bin/python3
