      },
      "set": {
        "income_category": "other"
      },
      "note": "Robinhood subscription-plan credit is non-position income; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "OTHER_INCOME",
        "sourceIncludes": "bithumb-statement"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Bithumb cash ledger income is not a security dividend; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "신규이벤트입금"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Broker promotional event credit is non-position income; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "세금환급"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Tax refund is non-position income; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "예탁금이용료정기입금"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Periodic cash-balance usage fee is non-position income; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "수수료 입금"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Broker fee credit is non-position income; keep it tickerless and classified as other."
    },
    {
