{
  "version": 1,
  "description": "Operating override layer. Read-only: the ingest applies these to normalized rows and records income_category, mapping_status, and mapping_note. Source spreadsheets, CSVs, and PDFs are never modified. Tracked in git so dev and prod stay identical and every change is attributable.",
  "incomeRules": [
    {
      "match": {
        "typeIncludes": "interest"
      },
      "set": {
        "income_category": "interest"
      },
      "note": "Broker cash-sweep and settlement interest arrives with no ticker; classify it as interest so it does not sit in the tickerless queue."
    },
    {
      "match": {
        "typeIncludes": "이자입금"
      },
      "set": {
        "income_category": "interest"
      },
      "note": "Korean broker cash interest is non-position income; keep it tickerless and classified as interest."
    },
    {
      "match": {
        "typeIncludes": "외화이자입금"
      },
      "set": {
        "income_category": "interest"
      },
      "note": "Korean broker foreign-currency cash interest is non-position income; keep it tickerless and classified as interest."
    },
    {
      "match": {
        "typeIncludes": "예탁금이용료입금"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Broker cash-balance usage fee is non-position income; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "선환전차액입금"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Pre-exchange difference credit is non-position cash income; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "무상단주대금입금"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Fractional-share cash settlement is not a position dividend without source security identity; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "OTHER_INCOME",
        "nameIncludes": "Merrill Edge Offer"
      },
      "set": {
        "income_category": "other"
      },
      "note": "Merrill promotional cash credit is non-position income; keep it tickerless and classified as other."
    },
    {
      "match": {
        "typeIncludes": "OTHER_INCOME",
