# Dependencies
node_modules
.pnpm-store/

# Next.js build output
.next/
out/
.vercel/

# Local environment
.env
.env.local
.env.*.local

# Copies of the files above. The rules match exact names, so a copy inherits
# none of them: workspace-governance's secret-rotate leaves a .bak-YYYYMMDD
# beside the original for a ~7-day soak so a bad rotation can be undone. This
# repository is public and .env.local holds live credentials, so that copy
# would land untracked-but-unignored — one `git add -A` from being committed.
.env*.bak
.env*.bak-*
.env*.backup*
.env*.orig
.env*.save

# Logs and local caches
*.log
.playwright-cli/
tsconfig.tsbuildinfo
__pycache__/
*.py[cod]

# Generated or private portfolio data.
# data/manual-mappings.json was tracked here until this repo went public. It is
# hand-written configuration rather than generated data, but its overrides are
# keyed to real payments — a date, a won amount and the statement they were
# confirmed against — so a git history of it is a git history of a portfolio.
# It travels the way tax-policy.json does instead: gitignored, 0600, carried to
# the refresh host by push-sources.sh. Start from data/manual-mappings.example.json.
private-data/
data/manual-mappings.json
data/fx-rates.json
data/kr-prices.json
data/us-prices.json
data/us-pdf-evidence.json
data/crypto-activity.json
data/crypto-prices.json
data/manual-mappings.sample.json
data/refresh-runs.json
data/tax-policy.json
# One generation of what push-sources.sh replaced, kept on the receiving side.
data/.push-backup/
data/tax-plans.json
data/historical-fx-rates.json
data/historical-prices.json
# Parsed broker certificates: every trade, with amounts. Never commit.
data/kr-statements/
# Live broker snapshot: positions, order history, amounts. Never commit.
data/toss-snapshot.json
# Live broker snapshot: every open Robinhood lot, with cost basis. Never commit.
data/robinhood-snapshot.json
# And its dated rotations. Regenerating the snapshot leaves the previous one
# beside it as `robinhood-snapshot.json.bak-20260811`, which matched nothing
# here — so the file sat untracked in the working tree of the refresh host,
# one `git add -A` away from committing every open lot and its cost basis.
# A rotation holds exactly what the file it backs up holds, so it is ignored
# for exactly the same reason.
data/*.bak-*
*.db
*.sqlite
*.sqlite3

