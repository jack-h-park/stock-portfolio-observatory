{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://finance-connectors.local/contracts/v1/run.schema.json",
  "type": "object",
  "required": [
    "manifest",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "runId",
        "provider",
        "environment",
        "sample",
        "connectionKey",
        "connectionId",
        "accountIds",
        "collectorVersion",
        "normalizerVersion",
        "startedAt",
        "fetchedAt",
        "historyScan",
        "lastFullScanAt",
        "sections",
        "accountStatus",
        "dependencies",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$"
        },
        "provider": {
          "const": "snaptrade"
        },
        "environment": {
          "enum": [
            "sandbox",
            "demo",
            "live"
          ]
        },
        "sample": {
          "type": "boolean"
        },
        "connectionKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$"
        },
        "connectionId": {
          "type": "string"
        },
        "accountIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "collectorVersion": {
          "type": "string"
        },
        "normalizerVersion": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "fetchedAt": {
          "type": "string"
        },
        "historyScan": {
          "enum": [
            "full",
            "incremental"
          ]
        },
        "lastFullScanAt": {
          "type": "string"
        },
        "sections": {
          "type": "object",
          "required": [
            "accounts",
            "balances",
            "positions",
            "activities"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "capability",
              "result",
              "asOf",
              "asOfPrecision"
            ],
            "properties": {
              "capability": {
                "enum": [
                  "supported",
                  "unsupported",
                  "unknown"
                ]
              },
              "result": {
                "enum": [
                  "complete",
                  "partial",
                  "failed",
                  "not_requested",
                  "unchanged"
                ]
              },
              "asOf": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "asOfPrecision": {
                "enum": [
                  "instant",
                  "date",
                  "unknown"
                ]
              },
              "coverage": {
                "type": "object"
              }
            }
          }
        },
        "accountStatus": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "runId",
              "manifestSha256"
            ],
            "additionalProperties": false,
            "properties": {
              "runId": {
                "type": "string"
              },
              "manifestSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "files": {
          "type": "object",
          "minProperties": 5,
          "propertyNames": {
            "pattern": "^(raw|normalized)/[A-Za-z0-9_/-]+\\.json$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "sha256",
              "bytes"
            ],
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "records": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
