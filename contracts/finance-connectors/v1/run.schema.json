              "accountRef": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "required": [
                  "runId",
                  "path",
                  "pointer"
                ],
                "additionalProperties": false,
                "properties": {
                  "runId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^raw/[A-Za-z0-9_/-]+\\.json$"
                  },
                  "pointer": {
                    "type": "string",
                    "pattern": "^/"
