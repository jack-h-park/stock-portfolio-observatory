{
  "name": "stock-portfolio-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only stock portfolio monitoring dashboard",
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev -p 3101",
    "build": "next build",
    "start": "next start -p 3101",
    "file:downloads": "node scripts/file-downloads.mjs",
    "fetch:fx": "node scripts/fetch-fx-rates.mjs",
    "fetch:kr-prices": "node scripts/fetch-kr-prices.mjs",
    "fetch:us-prices": "node scripts/fetch-us-prices.mjs",
    "fetch:historical-prices": "node scripts/fetch-historical-prices.mjs",
    "extract:us-pdf-evidence": "node scripts/extract-us-pdf-evidence.mjs",
    "extract:kr-statements": "node scripts/extract-kr-statements.mjs",
    "extract:fx-ledger": "node scripts/extract-fx-ledger.mjs",
    "fetch:toss": "node scripts/fetch-toss.mjs",
    "extract:crypto-activity": "node scripts/extract-crypto-activity.mjs",
    "fetch:crypto-prices": "node scripts/fetch-crypto-prices.mjs",
    "ingest": "node scripts/ingest-stock-data.mjs",
    "backfill:history": "node scripts/backfill-portfolio-history.mjs",
    "refresh": "node scripts/refresh.mjs",
    "summary": "tsx scripts/summary.mjs",
    "publish:kr-sheet": "node scripts/publish-sheet.mjs --market KR",
    "publish:us-sheet": "node scripts/publish-sheet.mjs --market US",
    "seed:sample": "node scripts/seed-sample.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ui:guardrails": "node scripts/ui-guardrails.mjs",
    "ui:a11y": "node scripts/a11y-audit.mjs",
    "ui:mobile": "node scripts/mobile-audit.mjs",
    "ui:snap": "node scripts/snap-ui.mjs",
    "ui:compare": "node scripts/snap-ui.mjs --compare"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "next": "^15.5.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.7",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
